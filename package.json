{
  "name": "oddlys-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ODDLYS 온라인 샵 — 기획·디자인 비교 프리뷰 (1·2단계)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "build:static": "tsc -b && VITE_ROUTER=hash vite build --base ./ --outDir dist-static",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
